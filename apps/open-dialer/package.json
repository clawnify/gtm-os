{
  "name": "open-dialer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 execute open-dialer-db --local --file=schema.sql && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8789\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "wrangler d1 execute open-dialer-db --local --file=seed.sql"
  },
  "dependencies": {
    "@clawnify/app": "^0.1.1",
    "@clawnify/db": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@twilio/voice-sdk": "^2.18.3",
    "hono": "^4.13.5",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
