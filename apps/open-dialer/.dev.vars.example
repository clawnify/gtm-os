# Copy to .dev.vars for local development. Never commit .dev.vars.
# In production these are set as Environment Variables in Clawnify and injected
# at deploy time; the app never shows them in the UI.

# Required: REST calls, number sync and webhook signature checks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: pin the default caller ID. Otherwise the first synced number is used.
TWILIO_FROM_NUMBER=

# Browser calling (Voice JS SDK). Without these three the app falls back to
# ringing your own phone first, then bridging to the lead.
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Optional. Twilio home region: us1 (default) or ie1 (Ireland, EU data residency).
# Every Twilio credential above must be created in this region.
TWILIO_REGION=us1

# Optional. The app uses the request origin for Twilio callback URLs; set this
# only when the public URL differs (a tunnel during local development).
PUBLIC_APP_URL=
